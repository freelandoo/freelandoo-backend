# Segurança 0B (2026-11-09) — blindagem contra vermes de npm.
# Pacote nenhum roda script na instalação. Os que precisam (bcrypt, ffmpeg-static)
# são liberados um a um no Dockerfile com `npm rebuild --ignore-scripts=false`.
ignore-scripts=true
# Versão publicada há menos de 7 dias não entra (é onde o verme mora). npm 11+.
min-release-age=7
# Dependência por repositório git não entra.
allow-git=none
